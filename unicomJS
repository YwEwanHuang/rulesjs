  // ── 1. 过滤代理节点 ──
  // 排除 server 为 127.0.0.1 的占位/信息节点
  var proxies = (config.proxies || []).filter(function(p) {
    var server = (p.server || "").toString().trim();
    return server && server !== "127.0.0.1" && server.indexOf("127.") !== 0;
  });

  // 保存原始节点数用于日志
  var originalCount = (config.proxies || []).length;
  var filteredCount = originalCount - proxies.length;
  if (filteredCount > 0) {
    var filteredNames = [];
    (config.proxies || []).forEach(function(p) {
      var server = (p.server || "").toString().trim();
      if (server === "127.0.0.1" || server.indexOf("127.") === 0) {
        filteredNames.push(p.name || "(unnamed)");
      }
    });
    console.log("[clash-rule] 已过滤占位节点: " + filteredNames.join(", "));
  }

  var proxyNames = proxies.map(function(p) { return p.name || "(unnamed)"; });
